{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Bollo MVP built-in tool intents",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "name": {
          "const": "read_file"
        },
        "arguments": {
          "type": "object",
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            },
            "offset": {
              "type": "integer",
              "minimum": 1
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 2000
            }
          },
          "required": [
            "path"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "name",
        "arguments"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "name": {
          "const": "search"
        },
        "arguments": {
          "type": "object",
          "properties": {
            "pattern": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            },
            "path": {
              "type": "string",
              "minLength": 1
            },
            "max_results": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000
            }
          },
          "required": [
            "pattern"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "name",
        "arguments"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "name": {
          "const": "write_file"
        },
        "arguments": {
          "type": "object",
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            },
            "content": {
              "type": "string",
              "maxLength": 1048576
            },
            "expected_sha256": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "path",
            "content",
            "expected_sha256"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "name",
        "arguments"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "name": {
          "const": "apply_patch"
        },
        "arguments": {
          "type": "object",
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            },
            "old_text": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1048576
            },
            "new_text": {
              "type": "string",
              "maxLength": 1048576
            },
            "expected_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          },
          "required": [
            "path",
            "old_text",
            "new_text",
            "expected_sha256"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "name",
        "arguments"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "name": {
          "const": "exec"
        },
        "arguments": {
          "type": "object",
          "properties": {
            "argv": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "minItems": 1,
              "maxItems": 128
            },
            "cwd": {
              "type": "string",
              "minLength": 1
            },
            "timeout_seconds": {
              "type": "integer",
              "minimum": 1,
              "maximum": 600
            }
          },
          "required": [
            "argv",
            "cwd",
            "timeout_seconds"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "name",
        "arguments"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "name": {
          "const": "git_status"
        },
        "arguments": {
          "type": "object",
          "properties": {},
          "required": [],
          "additionalProperties": false
        }
      },
      "required": [
        "name",
        "arguments"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "name": {
          "const": "git_diff"
        },
        "arguments": {
          "type": "object",
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [],
          "additionalProperties": false
        }
      },
      "required": [
        "name",
        "arguments"
      ],
      "additionalProperties": false
    }
  ]
}
