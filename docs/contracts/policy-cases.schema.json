{
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "0.1"
    },
    "cases": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"
          },
          "profile": {
            "type": "string",
            "enum": [
              "read_only",
              "balanced",
              "workspace_auto",
              "unrestricted"
            ]
          },
          "sandbox": {
            "type": "string",
            "enum": [
              "workspace",
              "off"
            ]
          },
          "scenario": {
            "type": "string",
            "minLength": 1
          },
          "expected": {
            "type": "string",
            "enum": [
              "allow",
              "ask",
              "deny",
              "startup_error"
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "profile",
          "sandbox",
          "scenario",
          "expected",
          "reason"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    }
  },
  "required": [
    "schema_version",
    "cases"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
