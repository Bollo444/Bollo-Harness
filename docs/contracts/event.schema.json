{
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "0.1"
    },
    "event_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"
    },
    "session_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"
    },
    "run_id": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "seq": {
      "type": "integer",
      "minimum": 1
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "type": {
      "type": "string",
      "enum": [
        "run.started",
        "assistant.delta",
        "tool.proposed",
        "tool.result",
        "approval.requested",
        "approval.resolved",
        "policy.changed",
        "verification.result",
        "usage.updated",
        "run.finished"
      ]
    },
    "data": {
      "type": "object"
    }
  },
  "required": [
    "schema_version",
    "event_id",
    "session_id",
    "run_id",
    "seq",
    "timestamp",
    "type",
    "data"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Bollo persisted event envelope v0.1",
  "allOf": [
    {
      "if": {
        "properties": {
          "type": {
            "const": "run.started"
          }
        }
      },
      "then": {
        "properties": {
          "data": {
            "type": "object",
            "properties": {
              "state": {
                "const": "running"
              },
              "policy_revision": {
                "type": "integer",
                "minimum": 1
              },
              "provider": {
                "type": "string",
                "enum": [
                  "anthropic",
                  "xai"
                ]
              },
              "model": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "state",
              "policy_revision",
              "provider",
              "model"
            ],
            "additionalProperties": false
          },
          "run_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "assistant.delta"
          }
        }
      },
      "then": {
        "properties": {
          "data": {
            "type": "object",
            "properties": {
              "text": {
                "type": "string",
                "maxLength": 65536
              }
            },
            "required": [
              "text"
            ],
            "additionalProperties": false
          },
          "run_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "tool.proposed"
          }
        }
      },
      "then": {
        "properties": {
          "data": {
            "type": "object",
            "properties": {
              "tool_call_id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"
              },
              "tool_name": {
                "type": "string",
                "minLength": 1
              },
              "intent_hash": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "decision": {
                "type": "string",
                "enum": [
                  "allow",
                  "ask",
                  "deny"
                ]
              },
              "reason": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "tool_call_id",
              "tool_name",
              "intent_hash",
              "decision",
              "reason"
            ],
            "additionalProperties": false
          },
          "run_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "tool.result"
          }
        }
      },
      "then": {
        "properties": {
          "data": {
            "type": "object",
            "properties": {
              "tool_call_id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"
              },
              "status": {
                "type": "string",
                "enum": [
                  "succeeded",
                  "failed",
                  "denied",
                  "unknown"
                ]
              },
              "artifact_id": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "summary": {
                "type": "string",
                "maxLength": 8192
              }
            },
            "required": [
              "tool_call_id",
              "status",
              "artifact_id",
              "summary"
            ],
            "additionalProperties": false
          },
          "run_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "approval.requested"
          }
        }
      },
      "then": {
        "properties": {
          "data": {
            "type": "object",
            "properties": {
              "approval_id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"
              },
              "tool_call_id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"
              },
              "intent_hash": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "policy_revision": {
                "type": "integer",
                "minimum": 1
              },
              "expires_at": {
                "type": "string",
                "format": "date-time"
              },
              "summary": {
                "type": "string",
                "maxLength": 8192
              }
            },
            "required": [
              "approval_id",
              "tool_call_id",
              "intent_hash",
              "policy_revision",
              "expires_at",
              "summary"
            ],
            "additionalProperties": false
          },
          "run_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "approval.resolved"
          }
        }
      },
      "then": {
        "properties": {
          "data": {
            "type": "object",
            "properties": {
              "approval_id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"
              },
              "decision": {
                "type": "string",
                "enum": [
                  "approve",
                  "deny",
                  "expired",
                  "invalidated"
                ]
              }
            },
            "required": [
              "approval_id",
              "decision"
            ],
            "additionalProperties": false
          },
          "run_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "policy.changed"
          }
        }
      },
      "then": {
        "properties": {
          "data": {
            "type": "object",
            "properties": {
              "policy_revision": {
                "type": "integer",
                "minimum": 1
              },
              "profile": {
                "type": "string",
                "enum": [
                  "read_only",
                  "balanced",
                  "workspace_auto",
                  "unrestricted"
                ]
              },
              "sandbox": {
                "type": "string",
                "enum": [
                  "workspace",
                  "off"
                ]
              }
            },
            "required": [
              "policy_revision",
              "profile",
              "sandbox"
            ],
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "verification.result"
          }
        }
      },
      "then": {
        "properties": {
          "data": {
            "type": "object",
            "properties": {
              "status": {
                "type": "string",
                "enum": [
                  "passed",
                  "failed",
                  "skipped",
                  "inconclusive"
                ]
              },
              "command": {
                "anyOf": [
                  {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "minItems": 1
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "exit_code": {
                "anyOf": [
                  {
                    "type": "integer"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "artifact_id": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "status",
              "command",
              "exit_code",
              "artifact_id"
            ],
            "additionalProperties": false
          },
          "run_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "usage.updated"
          }
        }
      },
      "then": {
        "properties": {
          "data": {
            "type": "object",
            "properties": {
              "input_tokens": {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": 0
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "output_tokens": {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": 0
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "cost_microusd": {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": 0
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "cost_known": {
                "type": "boolean"
              }
            },
            "required": [
              "input_tokens",
              "output_tokens",
              "cost_microusd",
              "cost_known"
            ],
            "additionalProperties": false,
            "allOf": [
              {
                "if": {
                  "properties": {
                    "cost_known": {
                      "const": false
                    }
                  }
                },
                "then": {
                  "properties": {
                    "cost_microusd": {
                      "type": "null"
                    }
                  }
                }
              },
              {
                "if": {
                  "properties": {
                    "cost_known": {
                      "const": true
                    }
                  }
                },
                "then": {
                  "properties": {
                    "cost_microusd": {
                      "type": "integer",
                      "minimum": 0
                    }
                  }
                }
              }
            ]
          },
          "run_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "run.finished"
          }
        }
      },
      "then": {
        "properties": {
          "data": {
            "type": "object",
            "properties": {
              "state": {
                "type": "string",
                "enum": [
                  "completed",
                  "failed",
                  "cancelled",
                  "blocked",
                  "interrupted"
                ]
              },
              "reason": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "verification": {
                "type": "string",
                "enum": [
                  "passed",
                  "failed",
                  "skipped",
                  "inconclusive"
                ]
              }
            },
            "required": [
              "state",
              "reason",
              "verification"
            ],
            "additionalProperties": false
          },
          "run_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"
          }
        }
      }
    }
  ]
}
